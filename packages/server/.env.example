# Copy to .env and fill in. Never commit the real file.
GEMINI_API_KEY=
# Primary model; built-in fallbacks are tried after it automatically.
GEMINI_MODEL=gemini-3.6-flash
# Optional: replace the whole preference order, comma separated.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest
PORT=8099
NODE_ENV=development
# Proxy hops in front of the app (Cloud Run: 1). Used to find the real client IP.
TRUST_PROXY_HOPS=1
# Serve the built client from the API (set automatically in the container).
# STATIC_DIR=../client/dist
# Only needed if the client is hosted on a different origin.
# ALLOWED_ORIGIN=https://example.com
